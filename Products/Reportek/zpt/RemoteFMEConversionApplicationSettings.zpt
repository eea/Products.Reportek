<tal:block tal:content="structure here/manage_page_header"/>
<tal:block
  tal:define="manage_tabs_message python:options.get('manage_tabs_message')"
  tal:content="structure here/manage_tabs" />

<p class="form-help" i18n:translate="">
  To change property values, edit the values and click "Save Changes".
</p>

<tal:block define="problems here/validate_settings">
  <div tal:condition="problems" class="form-help"
       style="border-left: 4px solid #c00; padding: 0.5em 1em; margin: 1em 0;">
    <strong i18n:translate="">This application will not convert as configured:</strong>
    <ul>
      <li tal:repeat="problem problems">
        <strong tal:content="problem/level">level</strong>:
        <span tal:content="problem/message">message</span>
      </li>
    </ul>
  </div>
</tal:block>

<tal:block define="settings here/get_settings">
<form action="manage_settings" method="post">
  <table>
    <tr>
      <th align="left" i18n:translate="">Title</th>
      <td colspan="2"><input type="text" name="title" tal:attributes="value here/title" size="80" /></td>
    </tr>
    <tr>
      <th align="left" i18n:translate="">FME Server</th>
      <td colspan="2"><input type="text" name="FMEServer"
       tal:attributes="value settings/FMEServer" size="80" />
     </td>
   </tr>
   <tr>
    <th align="left" i18n:translate="">FME REST API version</th>
    <td colspan="2">
      <select name="FMEApiVersion" id="FMEApiVersion" style="width: 100%">
        <option value="v3" i18n:translate="" tal:attributes="selected python: not here.is_v4()">v3 (fmerest/v3 - removed in FME 2026.1)</option>
        <option value="v4" i18n:translate="" tal:attributes="selected python: here.is_v4()">v4 (FME Flow API v4)</option>
      </select>
    </td>
   </tr>
   <tr class="fme-v4-only">
    <th align="left" i18n:translate="">FME API endpoint (v4 only)</th>
    <td colspan="2"><input type="text" name="FMEApiEndpoint"
     tal:attributes="value settings/FMEApiEndpoint|nothing" size="80" />
     <em i18n:translate="">Defaults to <strong>fmeapiv4</strong>.</em></td>
   </tr>
   <tr class="fme-v4-only">
    <th align="left" i18n:translate="">FME Resource connection (v4 only)</th>
    <td colspan="2"><input type="text" name="FMEResourceConnection"
     tal:attributes="value settings/FMEResourceConnection|nothing" size="80" />
     <em i18n:translate="">Name of the resource connection, e.g. <strong>FME_SHAREDRESOURCE_TEMP</strong>. Replaces the v3 upload endpoint path.</em></td>
   </tr>
   <tr>
    <th align="left" i18n:translate="">FME Token Endpoint</th>
    <td colspan="2"><input type="text" name="FMETokenEndpoint"
     tal:attributes="value settings/FMETokenEndpoint" size="80" /></td>
   </tr>
  <tr>
    <th align="left" i18n:translate="">FME Username</th>
    <td colspan="2"><input type="text" name="FMEUser"
     tal:attributes="value settings/FMEUser" size="80" /></td>
   </tr>
   <tr>
    <th align="left" i18n:translate="">FME Password</th>
    <td colspan="2">
      <strong tal:condition="python: here.has_secret('FMEPassword')" style="color: #060;"
              i18n:translate="">&#10003; a password is stored</strong>
      <strong tal:condition="python: not here.has_secret('FMEPassword')" style="color: #666;"
              i18n:translate="">&#10007; no password stored</strong><br />
      <input type="password" name="FMEPassword" size="80" autocomplete="new-password"
             tal:attributes="placeholder python: 'leave empty to keep the stored password' if here.has_secret('FMEPassword') else 'no password stored'"/>
      <label><input type="checkbox" name="FMEPasswordClear" value="1" /> <span i18n:translate="">clear</span></label>
      <em tal:condition="python: here.has_secret('FMEPassword')" i18n:translate="">
        A password is stored. Leave empty to keep it.
      </em>
      <em tal:condition="python: not here.has_secret('FMEPassword')" i18n:translate="">
        No password stored.
      </em>
    </td>
   </tr>
   <tr>
    <th align="left" i18n:translate="">FME Token Expiration</th>
    <td colspan="1"><input type="text" name="FMETokenExpiration"
     tal:attributes="value settings/FMETokenExpiration" style="width: 100%"/></td>
     <td colspan="1">
      <select name="FMETokenTimeUnit" style="width: 100%">
        <option value="second" i18n:translate="" tal:attributes="selected python: settings['FMETokenTimeUnit'] == 'second'">Second(s)</option>
        <option value="minute" i18n:translate="" tal:attributes="selected python: settings['FMETokenTimeUnit'] == 'minute'">Minute(s)</option>
        <option value="hour" i18n:translate="" tal:attributes="selected python: settings['FMETokenTimeUnit'] == 'hour'">Hour(s)</option>
        <option value="day" i18n:translate="" tal:attributes="selected python: settings['FMETokenTimeUnit'] == 'day'">Day(s)</option>
      </select>
    </td>
  </tr>
   <tr>
    <th align="left" i18n:translate="">FME Token (Overrides automatic generation)</th>
    <td colspan="2">
      <strong tal:condition="python: here.has_secret('FMEToken')" style="color: #060;"
              i18n:translate="">&#10003; a token is stored</strong>
      <strong tal:condition="python: not here.has_secret('FMEToken')" style="color: #666;"
              i18n:translate="">&#10007; no token stored</strong><br />
      <input type="password" name="FMEToken" size="80" autocomplete="new-password"
             tal:attributes="placeholder python: 'leave empty to keep the stored token' if here.has_secret('FMEToken') else 'no token stored'"/>
      <label><input type="checkbox" name="FMETokenClear" value="1" /> <span i18n:translate="">clear</span></label>
      <em tal:condition="python: here.has_secret('FMEToken')" i18n:translate="">
        A token is stored. Leave empty to keep it, or tick clear to fall back to automatic generation.
      </em>
      <em tal:condition="python: not here.has_secret('FMEToken')" i18n:translate="">
        No token stored, one is generated from the username and password below.
      </em>
    </td>
  </tr>
  <tr class="fme-v3-only">
    <th align="left" i18n:translate="">FME Upload endpoint (v3 only)</th>
    <td colspan="2"><input type="text" name="FMEUploadEndpoint"
     tal:attributes="value settings/FMEUploadEndpoint|nothing" size="80" /></td>
   </tr>
   <tr>
    <th align="left" i18n:translate="">FME Upload directory (relative to FME Upload Endpoint)</th>
    <td colspan="2"><input type="text" name="FMEUploadDir"
     tal:attributes="value settings/FMEUploadDir|nothing" size="80" /></td>
   </tr>
   <tr class="fme-v3-only">
    <th align="left" i18n:translate="">FME Transformation path (v3 only)</th>
    <td colspan="2"><input type="text" name="FMETransformation"
     tal:attributes="value settings/FMETransformation|nothing" size="80" /></td>
   </tr>
   <tr class="fme-v4-only">
    <th align="left" i18n:translate="">FME Repository (v4 only)</th>
    <td colspan="2"><input type="text" name="FMERepository"
     tal:attributes="value settings/FMERepository|nothing" size="80" />
     <em i18n:translate="">Repository of the workspace to run. In v4 the repository is sent in the job payload, not in the url.</em></td>
   </tr>
   <tr>
    <th align="left" i18n:translate="">FME Workspace</th>
    <td colspan="2"><input type="text" name="FMEWorkspace"
     tal:attributes="value settings/FMEWorkspace|nothing" size="80" /></td>
   </tr>
   <tr>
    <th align="left" i18n:translate="">
      FME Workspace exec parameters (JSON template)
    </th>
    <td colspan="2">
      <textarea name="FMEWorkspaceParams" rows="20" cols="80" size="80" tal:content="settings/FMEWorkspaceParams|nothing"><!--  --></textarea>
    </td>
    <td i18n:translate="">
      Available variables: 
      <ul>
        <li i18n:translate=""><strong>GET_FILE</strong> - The last uploaded envelope file of the required filetype</li>
        <li i18n:translate=""><strong>GET_SHAPEFILE</strong> - The last uploaded shapefile (last .shp or .zip)</li>
        <li i18n:translate=""><strong>FMEUPLOADDIR</strong> -  The FME Upload directory value</li>
        <li i18n:translate=""><strong>GET_ENV_OBLIGATION</strong> - The obligation number of the envelope (e.g. 780)</li>
        <li i18n:translate=""><strong>ENVPATHTOKENIZED</strong> - The tokenized path of the envelope (e.g. /ro/eu/envelope_id = ro_eu_envelope_id)</li>
      </ul>
      <p i18n:translate="">
        With the <strong>v4</strong> API, <strong>publishedParameters</strong> must be a JSON
        object, e.g. <code>{"publishedParameters": {"inputfile": "{GET_FILE}"}}</code>,
        instead of the v3 list of name/value pairs.
      </p>
    </td>
  </tr>
  <tr>
    <th align="left" i18n:translate="">FME Upload Parameters (one per line)</th>
    <td colspan="2">
      <textarea name="FMEUploadParams"
        tal:content="settings/FMEUploadParams|nothing" rows="10" cols="80" size="80"></textarea>
    </td>
  </tr>
  <tr>
    <th align="left" i18n:translate="">FME Convert Filetypes (one per line)</th>
    <td colspan="2">
      <textarea name="FMEFileTypes"
      tal:content="settings/FMEFileTypes|nothing" rows="5" cols="80" size="80"></textarea>
    </td>
  </tr>
  <tr>
    <th align="left" i18n:translate="">FME Upload all files in the envelope</th>
    <td colspan="2">
      <input type="checkbox" name="FMEUploadAll" tal:attributes="checked settings/FMEUploadAll; value settings/FMEUploadAll" />
    </td>
  </tr>
  <tr>
    <th align="left" i18n:translate="">FME Post Conversion Cleanup</th>
    <td colspan="2">
      <input type="checkbox" name="FMEConvCleanup" tal:attributes="checked settings/FMEConvCleanup; value settings/FMEConvCleanup"/>
    </td>
  </tr>
  <tr>
    <th align="left" i18n:translate="">Activity ID</th>
    <td colspan="2"><input type="text" name="app_name"
     tal:attributes="value settings/app_name" size="80" /></td>
   </tr>
   <tr>
    <th align="left" i18n:translate="">Maximum number of retries</th>
    <td colspan="2"><input type="text" name="nRetries" tal:attributes="value settings/nRetries" size="5" /></td>
  </tr>
  <tr>
    <th align="left" i18n:translate="">Frequency of retry (seconds)</th>
    <td align="left">
      <input type="text" name="retryFrequency" id="retryFrequency" tal:attributes="value settings/retryFrequency" size="5" />
    </td>
  </tr>
  <tr>
    <th align="left" i18n:translate="">FME connect timeout (seconds)</th>
    <td align="left">
      <input type="text" name="FMEConnectTimeout" tal:attributes="value settings/FMEConnectTimeout|nothing" size="5" />
      <em i18n:translate="">Time to wait for FME to accept the connection. Empty or 0 waits forever.</em>
    </td>
  </tr>
  <tr>
    <th align="left" i18n:translate="">FME read timeout (seconds)</th>
    <td align="left">
      <input type="text" name="FMEReadTimeout" tal:attributes="value settings/FMEReadTimeout|nothing" size="5" />
      <em i18n:translate="">Time to wait between two chunks of an FME response. Empty or 0 waits forever.</em>
    </td>
  </tr>
  <tr>
    <td></td>
    <td><input type="submit" value="Save Changes" i18n:attributes="value btn-save-changes" /></td>
  </tr>
</table>
</form>
</tal:block>

<script type="text/javascript">
  (function () {
    var select;

    function toggleApiVersionRows() {
      var isV4 = select.value === "v4";
      var rows = document.querySelectorAll("tr.fme-v3-only, tr.fme-v4-only");
      for (var i = 0; i < rows.length; i++) {
        var v4Only = rows[i].className.indexOf("fme-v4-only") !== -1;
        rows[i].style.display = (v4Only === isV4) ? "" : "none";
      }
    }

    function init() {
      select = document.getElementById("FMEApiVersion");
      if (!select) { return; }
      select.addEventListener("change", toggleApiVersionRows);
      toggleApiVersionRows();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
<tal:block tal:content="structure here/manage_page_footer"/>
