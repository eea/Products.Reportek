<metal:block use-macro="container/standard_template.pt/macros/page">
  <metal:block fill-slot="content">
    <table tal:define="settings here/get_settings">
      <tr>
        <th align="left" i18n:translate="">Title</th>
        <td colspan="2"><input type="text" name="title" tal:attributes="value here/title" size="80" disabled="disabled"/></td>
      </tr>
      <tr>
        <th align="left" i18n:translate="">FME Server</th>
        <td colspan="2"><input type="text" name="FMEServer"
                   tal:attributes="value settings/FMEServer" size="80" disabled="disabled"/>
        </td>
      </tr>
      <tr>
        <th align="left" i18n:translate="">FME REST API version</th>
        <td colspan="2"><input type="text" name="FMEApiVersion"
                   tal:attributes="value settings/FMEApiVersion|nothing" size="80" disabled="disabled"/></td>
      </tr>
      <tr tal:condition="python: here.is_v4()">
        <th align="left" i18n:translate="">FME API endpoint (v4 only)</th>
        <td colspan="2"><input type="text" name="FMEApiEndpoint"
                   tal:attributes="value settings/FMEApiEndpoint|nothing" size="80" disabled="disabled"/></td>
      </tr>
      <tr tal:condition="python: here.is_v4()">
        <th align="left" i18n:translate="">FME Resource connection (v4 only)</th>
        <td colspan="2"><input type="text" name="FMEResourceConnection"
                   tal:attributes="value settings/FMEResourceConnection|nothing" size="80" disabled="disabled"/></td>
      </tr>
      <tr tal:condition="python: not here.is_v4()">
        <th align="left" i18n:translate="">FME Upload endpoint (v3 only)</th>
        <td colspan="2"><input type="text" name="FMEUploadEndpoint"
                   tal:attributes="value settings/FMEUploadEndpoint|nothing" size="80" disabled="disabled"/></td>
      </tr>
      <tr>
        <th align="left" i18n:translate="">FME Upload directory (relative to FME Upload Endpoint)</th>
        <td colspan="2"><input type="text" name="FMEUploadDir"
                   tal:attributes="value settings/FMEUploadDir|nothing" size="80" disabled="disabled"/></td>
      </tr>
      <tr tal:condition="python: not here.is_v4()">
        <th align="left" i18n:translate="">FME Transformation path (v3 only)</th>
        <td colspan="2"><input type="text" name="FMETransformation"
                   tal:attributes="value settings/FMETransformation|nothing" size="80" disabled="disabled"/></td>
      </tr>
      <tr tal:condition="python: here.is_v4()">
        <th align="left" i18n:translate="">FME Repository (v4 only)</th>
        <td colspan="2"><input type="text" name="FMERepository"
                   tal:attributes="value settings/FMERepository|nothing" size="80" disabled="disabled"/></td>
      </tr>
      <tr>
        <th align="left" i18n:translate="">FME Workspace</th>
        <td colspan="2"><input type="text" name="FMEWorkspace"
                   tal:attributes="value settings/FMEWorkspace|nothing" size="80" disabled="disabled"/></td>
      </tr>
      <tr>
        <th align="left" i18n:translate="">FME Workspace exec parameters (JSON template)</th>
        <td colspan="2">
          <textarea tal:content="settings/FMEWorkspaceParams|nothing"
                    name="FMEWorkspaceParams" rows="20" cols="80" size="80"
                    disabled="disabled"></textarea>
        </td>
      </tr>
      <tr>
        <th align="left" i18n:translate="">FME Upload Parameters (one per line)</th>
        <td colspan="2">
          <textarea name="FMEUploadParams"
            tal:content="settings/FMEUploadParams|nothing" rows="10" cols="80" size="80" disabled="disabled"></textarea>
        </td>
      </tr>
      <tr>
        <th align="left" i18n:translate="">FME Convert Filetypes (one per line)</th>
        <td colspan="2">
          <textarea name="FMEFileTypes"
            tal:content="settings/FMEFileTypes|nothing" rows="5" cols="80" size="80" disabled="disabled"></textarea>
        </td>
      </tr>
      <tr>
        <th align="left" i18n:translate="">FME Upload all files in the envelope</th>
        <td colspan="2">
          <input type="checkbox" name="FMEUploadAll" tal:attributes="checked settings/FMEUploadAll; value settings/FMEUploadAll" disabled="disabled"/>
        </td>
      </tr>
      <tr>
        <th align="left" i18n:translate="">FME Post Conversion Cleanup</th>
        <td colspan="2">
          <input type="checkbox" name="FMEConvCleanup" tal:attributes="checked settings/FMEConvCleanup; value settings/FMEConvCleanup" disabled="disabled"/>
        </td>
      </tr>
        <tr>
            <th align="left" i18n:translate="">FME connect timeout (seconds)</th>
            <td colspan="2"><input type="text" name="FMEConnectTimeout"
                       tal:attributes="value settings/FMEConnectTimeout|nothing" size="5" disabled="disabled"/></td>
        </tr>
        <tr>
            <th align="left" i18n:translate="">FME read timeout (seconds)</th>
            <td colspan="2"><input type="text" name="FMEReadTimeout"
                       tal:attributes="value settings/FMEReadTimeout|nothing" size="5" disabled="disabled"/></td>
        </tr>
        <tr>
            <th align="left" i18n:translate="">Activity ID</th>
        <td colspan="2"><input type="text" name="app_name"
                   tal:attributes="value settings/app_name" size="80" disabled="disabled"/></td>
        </tr>
        <tr>
            <th align="left" i18n:translate="">Maximum number of retries</th>
            <td colspan="2"><input type="text" name="nRetries" tal:attributes="value settings/nRetries" size="5" disabled="disabled"/></td>
        </tr>
        <tr>
            <th align="left"><label i18n:translate="">Frequency of retry (seconds)</label></th>
            <td align="left">
                <input type="text" name="retryFrequency" id="retryFrequency" tal:attributes="value settings/retryFrequency" size="5" disabled="disabled"/> 
            </td>
        </tr>
    </table>
  </metal:block>
</metal:block>
