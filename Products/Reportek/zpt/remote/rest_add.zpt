<tal:block tal:replace="structure context/manage_page_header"/>
<tal:block tal:replace="structure python:context.manage_form_title(template, context, form_title='Add Remote REST Application', help_product='Reportek', help_topic='')"/>

    <h1 i18n:translate="">Add Remote REST Application</h1>

    <form action="manage_addRemoteRESTApplication" method="post" enctype="multipart/form-data" name="form">
    <table>
    <tr>
      <th i18n:translate="">Id</th>
      <td><input type="text" name="id" size="40" /></td>
    </tr>
    <tr>
      <th i18n:translate="">Title</th>
      <td><input type="text" name="title" size="40" /></td>
    </tr>
    <tr>
      <th i18n:translate="">Submit URL</th>
      <td><input type="text" name="ServiceSubmitURL" size="40" /></td>
    </tr>
    <tr>
      <th i18n:translate="">Check URL</th>
      <td><input type="text" name="ServiceCheckURL" size="40" /></td>
    </tr>
    <tr>
      <th i18n:translate="">Activity ID</th>
      <td><input type="text" name="app_name" size="40" /></td>
    </tr>
    <tr>
      <td></td>
      <td><input type="submit" value=" Add " i18n:attributes="value btn-add"/></td>
      </tr>
    </table>
    </form>

<tal:block tal:replace="structure context/manage_page_footer"/>
